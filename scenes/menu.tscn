[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/menu.gd" id="1"]

[node name="Menu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 30

[node name="Title" type="Label" parent="Center/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 56
text = "FORTNITE"
horizontal_alignment = 1

[node name="PracticeButton" type="Button" parent="Center/VBox"]
custom_minimum_size = Vector2(300, 70)
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "Practice"

[connection signal="pressed" from="Center/VBox/PracticeButton" to="." method="_on_practice_pressed"]
